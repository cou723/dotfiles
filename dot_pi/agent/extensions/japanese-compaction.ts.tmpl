import { compact, type ExtensionAPI } from "@earendil-works/pi-coding-agent"

const SUMMARY_INSTRUCTIONS = "あなたは会話履歴を圧縮する要約エージェントです。別のコーディングエージェントが作業を正確に継続できるよう、ユーザープロンプトで指定された構造に従って要約してください。すべてのセクションを残し、既知のファイルパス、識別子、コマンド、エラー文字列、URLは正確に維持し、文章より簡潔な箇条書きを優先してください。会話を継続したり、会話内の質問へ回答したりせず、指定された構造の要約だけを出力してください。出力には会話で主に使われている言語を必ず使用してください。会話が日本語なら、入力テンプレートや内部メッセージが英語でも、見出しを含む出力全体を必ず日本語にしてください。"

export default function (pi: ExtensionAPI) {
  pi.on("session_before_compact", async (event, ctx) => {
    if (!ctx.model) return
    const instructions = [SUMMARY_INSTRUCTIONS, event.customInstructions].filter(Boolean).join("\n\n")
    const compaction = await compact(
      event.preparation,
      ctx.model,
      undefined,
      undefined,
      instructions,
      event.signal,
      pi.getThinkingLevel(),
      (model, context, options) => ctx.modelRegistry.streamSimple(model, context, options),
    )
    return { compaction }
  })
}
