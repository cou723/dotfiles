{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permissionDialogKeys": {
    "approve": "1",
    "approveSession": "2",
    "approveSessionBoth": "3",
    "deny": "4",
    "denyWithReason": "5"
  },
  "promptNotifications": ["bell"],
  "authorizerChain": ["resource-tool-gate", "bash-classifier"],
  "shellTools": {
    "exec_command": {"commandArgument": "cmd", "workdirArgument": "workdir"}
  },
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": {"action": "deny", "reason": "秘密情報を含むenvファイルはagentに公開しません。"},
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/mcp-auth.json": "deny",
      "~/.secrets": "deny"
    },
    "path_write": {
      "~/.pi/agent/extensions/*": "deny",
      "~/ghq/github.com/cou723/pi-resource-capabilities": "deny",
      "~/ghq/github.com/cou723/pi-resource-capabilities/*": "deny",
      "~/.pi/agent/npm/*": "deny",
      "~/.pi/agent/trust/*": "deny",
      "~/.pi/agent/lsp.json": "deny",
      "~/.pi/agent/resource-capability-runtime.json": "deny",
      "~/.pi/agent/resource-capability-gate.json": "deny",
      "~/.local/share/pi-language-servers/*": "deny",
      "{{ .chezmoi.sourceDir }}/dot_local/share/pi-language-servers/*": "deny",
      "~/.pi/agent/settings.json": "deny",
      "~/.pi/agent/mcp.json": "deny",
      "~/.pi/agent/hermes-memory-config.json": "deny",
      "~/.pi/agent/subagents.json": "deny",
      "~/.pi/agent/AGENTS.md": "deny",
      "{{ .chezmoi.sourceDir }}/dot_pi/*": "deny"
    },
    "external_directory_read": {
      "*": "ask",
      "/tmp/pi": "allow",
      "~/ghq/github.com/cou723/pi-resource-capabilities": "allow",
      "~/ghq/github.com/cou723/pi-resource-capabilities/*": "allow",
      "/tmp/pi/*": "allow",
      "~/.pi/agent/pi-hermes-memory/*": "allow",
      "~/.pi/agent/projects-memory/*": "allow"
    },
    "external_directory_write": {
      "*": "ask",
      "/tmp/pi/*": "allow",
      "~/.pi/agent/pi-hermes-memory/*": "allow",
      "~/.pi/agent/projects-memory/*": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "npm *": {"action": "deny", "reason": "npmではなくpnpmを使用してください。"},
      "*/npm *": {"action": "deny", "reason": "npmではなくpnpmを使用してください。"},
      "npx *": {"action": "deny", "reason": "npxではなく、version固定したpnpm exec/dlxを使用してください。"},
      "sudo *": "deny",
      "doas *": "deny",
      "gh *": {"action": "deny", "reason": "GitHub操作はResource capability付きMCP経路を使用してください。"},
      "rm -rf /": "deny",
      "rm -rf -- /": "deny",
      "git push *--force*": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny"
    },
    "mcp": "ask",
    "skill": "allow",
    "codemode": "allow",
    "tool_search": "allow",
    "lsp_diagnostics": "allow",
    "lsp_hover": "allow",
    "lsp_definition": "allow",
    "lsp_references": "allow",
    "lsp_symbols": "allow",
    "memory_add": "allow",
    "memory_replace": "allow",
    "memory_remove": "allow",
    "memory_search": "allow",
    "session_search": "allow",
    "skill_manage": "allow",
    "subagent": "allow",
    "get_subagent_result": "allow",
    "steer_subagent": "allow",
    "ask_parent": "allow",
    "notify_parent": "allow"
  }
}
