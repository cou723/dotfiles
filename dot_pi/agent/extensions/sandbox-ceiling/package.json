{
  "name": "local-pi-sandbox-ceiling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "node tests/definitions.test.mjs && node tests/project-config-write.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@eslint/js": "10.0.1",
    "@gotgenes/pi-subagents": "21.9.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.4.0",
    "prettier": "3.9.9",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@gotgenes/pi-subagents": "21.9.1",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
