{
  "version": 1,
  "servers": [
    {
      "id": "typescript", "bin": "node",
      "args": ["{{ .chezmoi.homeDir }}/ghq/github.com/cou723/pi-resource-capabilities/resource-capability-gate/lsp-server.mjs", "{{ .chezmoi.homeDir }}/.pi/agent", "typescript"],
      "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mts", "**/*.cts", "**/*.mjs", "**/*.cjs"],
      "exclude": ["**/node_modules/**", "**/.git/**", "**/dist/**"],
      "rootMarkers": ["tsconfig.json", "jsconfig.json", "package.json", ".git"],
      "cwd": "{root}", "diagnosticsWaitMs": 1800,
      "languageIdByExtension": {".ts": "typescript", ".tsx": "typescriptreact", ".js": "javascript", ".jsx": "javascriptreact", ".mts": "typescript", ".cts": "typescript", ".mjs": "javascript", ".cjs": "javascript"},
      "initializationOptions": {
        "disableAutomaticTypingAcquisition": true,
        "tsserver": {"path": "{{ .chezmoi.homeDir }}/.local/share/pi-language-servers/node_modules/typescript/lib/tsserver.js"}
      }
    },
    {
      "id": "python", "bin": "node",
      "args": ["{{ .chezmoi.homeDir }}/ghq/github.com/cou723/pi-resource-capabilities/resource-capability-gate/lsp-server.mjs", "{{ .chezmoi.homeDir }}/.pi/agent", "python"],
      "include": ["**/*.py", "**/*.pyi"], "exclude": ["**/.venv/**", "**/venv/**"],
      "rootMarkers": ["pyproject.toml", "pyrightconfig.json", ".git"],
      "cwd": "{root}", "diagnosticsWaitMs": 1800,
      "languageIdByExtension": {".py": "python", ".pyi": "python"}
    },
    {
      "id": "json", "bin": "node",
      "args": ["{{ .chezmoi.homeDir }}/ghq/github.com/cou723/pi-resource-capabilities/resource-capability-gate/lsp-server.mjs", "{{ .chezmoi.homeDir }}/.pi/agent", "json"],
      "include": ["**/*.json", "**/*.jsonc"], "exclude": ["**/node_modules/**"],
      "rootMarkers": ["package.json", ".git"], "cwd": "{root}", "diagnosticsWaitMs": 1000,
      "languageIdByExtension": {".json": "json", ".jsonc": "jsonc"}
    },
    {
      "id": "yaml", "bin": "node",
      "args": ["{{ .chezmoi.homeDir }}/ghq/github.com/cou723/pi-resource-capabilities/resource-capability-gate/lsp-server.mjs", "{{ .chezmoi.homeDir }}/.pi/agent", "yaml"],
      "include": ["**/*.yaml", "**/*.yml"], "exclude": ["**/node_modules/**"],
      "rootMarkers": ["package.json", ".git"], "cwd": "{root}", "diagnosticsWaitMs": 1000,
      "languageIdByExtension": {".yaml": "yaml", ".yml": "yaml"}
    },
    {
      "id": "rust", "enabled": false, "bin": "node",
      "args": ["{{ .chezmoi.homeDir }}/ghq/github.com/cou723/pi-resource-capabilities/resource-capability-gate/lsp-server.mjs", "{{ .chezmoi.homeDir }}/.pi/agent", "rust"],
      "include": ["**/*.rs"], "exclude": ["**/target/**"],
      "rootMarkers": ["Cargo.toml", ".git"], "cwd": "{root}", "diagnosticsWaitMs": 2000,
      "languageIdByExtension": {".rs": "rust"},
      "initializationOptions": {"cargo": {"buildScripts": {"enable": false}}, "procMacro": {"enable": false}, "checkOnSave": false}
    },
    {
      "id": "cpp", "bin": "node",
      "args": ["{{ .chezmoi.homeDir }}/ghq/github.com/cou723/pi-resource-capabilities/resource-capability-gate/lsp-server.mjs", "{{ .chezmoi.homeDir }}/.pi/agent", "cpp"],
      "include": ["**/*.c", "**/*.h", "**/*.cpp", "**/*.hpp", "**/*.cc", "**/*.cxx"],
      "rootMarkers": ["compile_commands.json", "CMakeLists.txt", ".git"], "cwd": "{root}", "diagnosticsWaitMs": 1500,
      "languageIdByExtension": {".c": "c", ".h": "c", ".cpp": "cpp", ".hpp": "cpp", ".cc": "cpp", ".cxx": "cpp"}
    }
  ]
}
