{
  "version": 1,
  "backend": "bubblewrap",
  "executable": "${home}/.nix-profile/bin/bwrap",
  "runtimeRead": [
    "/usr", "/bin", "/lib", "/lib64", "/nix/store",
    "${home}/.nix-profile",
    "${home}/.local/share/pnpm/store",
    "/etc/ld.so.cache", "/etc/resolv.conf", "/etc/hosts", "/etc/nsswitch.conf",
    "/etc/ssl/certs", "/etc/alternatives"
  ],
  "ceiling": {
    "capabilities": {
      "filesystem": {
        "read": ["${workspace}", "{{ .chezmoi.sourceDir }}", "${home}/.pi/agent", "${home}/.local/share/pnpm/store/v11/links/@earendil-works", "/tmp/pi"],
        "write": ["${workspace}", "{{ .chezmoi.sourceDir }}/dot_pi/agent", "${home}/.pi/agent", "/tmp/pi"]
      },
      "network": "allow",
      "process": { "signals": { "target": "own-tree" } },
      "environment": {
        "inherit": ["PATH", "LANG", "TERM"],
        "set": { "HOME": "${agentHome}", "TMPDIR": "${agentTmp}" }
      }
    },
    "credentials": { "github": { "access": "read" } }
  },
  "credentialSources": {
    "github": { "read": "PI_GITHUB_READ_TOKEN" }
  },
  "maintenance": {
    "sourceDir": "{{ .chezmoi.sourceDir }}",
    "executable": "${home}/.nix-profile/bin/chezmoi"
  },
  "timeoutMs": 600000
}
