{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "exposure": "codemode"
    },
    "todoist": {
      "url": "https://ai.todoist.net/mcp",
      "exposure": "codemode"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "!printf 'Bearer %s' \"$(gh auth token)\"" },
      "exposure": "codemode"
    },
    "amazon-products": {
      "command": "{{ .chezmoi.homeDir }}/.local/bin/amazon-products-mcp",
      "args": [],
      "env": {
        "AMAZON_REGION": "jp",
        "CHROME_EXEC_PATH": "/usr/bin/google-chrome"
      },
      "timeout": 90,
      "exposure": "codemode"
    }
  }
}
